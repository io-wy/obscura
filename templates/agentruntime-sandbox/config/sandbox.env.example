# Copy to a local, ignored file before running the runtime.
# Never point tests at production services or credentials.

SANDBOX_STATE_DIR=.runtime/state
SANDBOX_DEPS_DIR=.runtime/deps
SANDBOX_LOG_DIR=.runtime/logs
SANDBOX_NETWORK_POLICY=egress-deny
SANDBOX_RUNTIME_USER=agent-runtime
SANDBOX_MAX_LIFETIME_SECONDS=3600
SANDBOX_TEMPLATE_ID=local-dev

# Optional backend requirements.
SANDBOX_REQUIRE_KVM=false
SANDBOX_OBJECT_STORE_ENDPOINT=
SANDBOX_OBJECT_STORE_BUCKET=
